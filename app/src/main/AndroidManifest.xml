<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional: only used to offer contacts in the search. The launcher works without it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Optional: the next appointments under the clock. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!--
      Optional: the weather line. Coarse accuracy only, and the position never leaves the
      device except as the coordinates in the Open-Meteo request.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Optional: only declared so that the launcher appears in the usage access list. It is
      granted by hand in the system settings, never by a dialog, and drives nothing but the
      open counter of the usage breaker.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Package visibility. Still no QUERY_ALL_PACKAGES: the launcher declares the intents it
      genuinely has to resolve and gets exactly the matching apps.

      MAIN + LAUNCHER is what makes the app list complete. Without it Android 11+ filtering
      hides every app the launcher has no declared interest in, and `LauncherApps` returns
      only the preinstalled ones plus the icon packs below - which is what shipped in v0.1.0.
      The list itself still comes from LauncherApps, never from queryIntentActivities.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinimalistLauncher">

        <!--
          MAIN + HOME + DEFAULT + LAUNCHER_APP marks this activity as a home screen.
          CATEGORY_LAUNCHER is deliberately absent: a launcher must not show up in its
          own app list. Settings are reached from inside the launcher instead.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MinimalistLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
        </activity>

        <!--
          Optional: drives the notification previews and the media widget. Android revokes the
          access on every reinstall, so it has to be granted again after each adb install.
        -->
        <service
            android:name=".service.LauncherNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!--
          Optional: exists only so that the double tap and the swipe down gestures can run the
          two global actions (notification shade, lock screen). It subscribes to no events and
          cannot read window content; see res/xml/accessibility_service_config.xml.
        -->
        <service
            android:name=".service.LauncherGestureService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
